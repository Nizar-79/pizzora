# Copy this file to .env.local and fill in your values

# Anthropic (Claude AI)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Supabase (server-side — service role key, never expose to browser)
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# Supabase (public — safe to expose, used for auth in browser)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# POS Environment — set to "production" for real orders, "sandbox" for testing
POS_ENV=sandbox

# Webhook security — a random secret string shared with Thinkrr
WEBHOOK_SECRET=your_random_secret_string_here

# POS API Keys (only fill in the ones you use)
# For Clover, the format is: merchantId|apiKey
TOAST_API_KEY=your_toast_api_key_here
SQUARE_ACCESS_TOKEN=your_square_access_token_here
CLOVER_API_KEY=your_clover_merchant_id|your_clover_api_key_here
